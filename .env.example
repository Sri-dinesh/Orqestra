# Copy this file to .env.local for local development.
# Replace every placeholder with values from your Neon project.
# Never commit .env.local or any file containing real credentials.

# -----------------------------------------------------------------------------
# Browser / Vite
# -----------------------------------------------------------------------------

# Neon Managed Better Auth Base URL.
# Find this in Neon Console → Better Auth → Configuration → Project Info.
VITE_NEON_AUTH_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth

# -----------------------------------------------------------------------------
# Server / Neon Postgres / Drizzle
# -----------------------------------------------------------------------------

# Neon Postgres connection string.
# Find this in Neon Console → Connect → Connection string.
DATABASE_URL=postgresql://your_user:your_password@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Server / Neon Auth JWT verification
# -----------------------------------------------------------------------------

# Neon Managed Better Auth Base URL used by the server.
NEON_AUTH_BASE_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth

# Neon Auth JWKS endpoint used to verify browser-issued JWTs.
NEON_AUTH_JWKS_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth/jwt

# JWT issuer expected from Neon Auth.
NEON_AUTH_ISSUER=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth
