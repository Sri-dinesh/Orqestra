# =============================================================================
# Orqestra Environment Variables Configuration
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, Railway), configure these in your project settings.
# =============================================================================

# -----------------------------------------------------------------------------
# Browser / Client Authentication
# -----------------------------------------------------------------------------
# Neon Managed Auth Base URL (Public, accessible by browser and Next.js client)
# Find this in Neon Console → Better Auth → Configuration → Project Info.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth

# -----------------------------------------------------------------------------
# Server / Neon Postgres Database
# -----------------------------------------------------------------------------
# Neon Postgres connection string (Pooled connection string recommended for serverless)
# Find this in Neon Console → Connect → Connection string.
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# -----------------------------------------------------------------------------
# Server / Neon Auth JWT Verification
# -----------------------------------------------------------------------------
# Neon Managed Auth Base URL used by server-side API routes to verify JWTs.
NEON_AUTH_BASE_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth

# Neon Auth JWKS endpoint used to verify browser-issued JWTs.
# Defaults to ${NEON_AUTH_BASE_URL}/.well-known/jwks.json if omitted.
NEON_AUTH_JWKS_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth/.well-known/jwks.json

# JWT issuer expected from Neon Auth.
# Defaults to NEON_AUTH_BASE_URL if omitted.
NEON_AUTH_ISSUER=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth
